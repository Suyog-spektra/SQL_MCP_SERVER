# Copy this file to .env and fill in your real values

# Your Azure SQL server + database (same one you've been using all along)
SQL_SERVER=<SQL_SERVER_ENDPOINT_URL>
SQL_DATABASE=<SQL_DATABASE_NAME>

# AUTH_MODE = "sql" or "entra"
#   sql   -> uses SQL_USER + SQL_PASSWORD below
#   entra -> uses your signed-in Entra ID identity (via az login / DefaultAzureCredential)
AUTH_MODE=entra

SQL_USER=
SQL_PASSWORD=
